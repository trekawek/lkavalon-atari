5 REM -------------------------------
10 POKE 106, 112:GRAPHICS 2+16
20 P6=1536:RDTA=P6:RHEX=P6+3
30 BEGN=36864:PLAY=BEGN+608:CAV=28672
50 POKE 559, 0:RESTORE 500:A=P6
60 READ B:IF B>-1 THEN POKE A, B:A=A+1:GOTO 60
100 A=BEGN+20:L=10030:DIM A$(40)
110 ERR=0:POKE ERR, 0
120 RESTORE 10000:TRAP 200
130 READ A$:X=USR(RHEX, ADR(A$), A):IF PEEK(ERR)=0 THEN A=A+12:L=L+10:GOTO 130
140 GRAPHICS 0:? "Popraw linie ";L:STOP
200 IF PEEK(195)<>6 THEN L=130:GOTO 140
210 RESTORE 1000
220 FOR A=708 TO 712:READ B:POKE A, B:NEXT A
230 FOR A=CAV TO CAV+2:READ B:POKE A, B:NEXT A
240 READ A$:IF A$(1, 1)="/" THEN X=USR(RDTA, ADR(A$), A):A=A+20:GOTO 240
400 X=USR(PLAY)
