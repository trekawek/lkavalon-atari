10 REM  APPEND MBD.FNT,MBD.OBJ
20 OPEN #1, 4, 0, "D:HL.FNT":TRAP 100
30 OPEN #2, 8, 0, "D:HL.DTA"
40 SKIP=6+20:GOSUB 1000
50 COPY=608-20:GOSUB 2000
60 CLOSE #1
70 OPEN #1, 4, 0, "D:HL.OBJ"
80 SKIP=6:GOSUB 1000
90 COPY=9999:GOSUB 2000
100 END
1000 REM  SKIP
1010 FOR A=1 TO SKIP:GET #1, B:NEXT A
1020 RETURN
2000 REM  COPY
2020 FOR A=1 TO COPY
2030 GET #1, B:PUT #2, B
2040 NEXT A
2050 RETURN
