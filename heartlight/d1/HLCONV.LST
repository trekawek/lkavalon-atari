1 REM  Chaos File To Data Converter
2 LINE=10030:STEP=10:LENG=12:MAX=20:L=LINE:DIM A$(20):OPEN #1, 4, 0, "D:HL.DTA":? "}":TRAP 8
3 FOR Y=1 TO MAX:CSUM=0:?:? L;" DATA ";:FOR X=1 TO LENG:GET #1, BYTE:SUM=SUM+1
4 CSUM=CSUM+BYTE:IF CSUM>255 THEN CSUM=CSUM-256
5 GOSUB 7:NEXT X:BYTE=CSUM:GOSUB 7:L=L+STEP:NEXT Y:GOSUB 6:? "}":GOTO 3
6 ?:? "POKE 842,12:CONT":POSITION 0, 0:POKE 842, 13:BYTE=0:STOP
7 HEX=BYTE:BYTE=INT(BYTE/16):HEX=HEX-BYTE*16:? CHR$(BYTE+48+39*(BYTE>9));:? CHR$(HEX+48+39*(HEX>9));:RETURN
8 BYTE=CSUM:GOSUB 7:IF X=1 THEN ? "\x9C"
9 GOSUB 6:? "}\x1D":FOR A=1 TO 9:? A:NEXT A:CLR:GOSUB 6
10000 REM ---------------------------
10010 REM :          GRA            :
10020 REM ---------------------------
