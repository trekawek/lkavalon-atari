( DEFINITION TRACER )

: BRNCH PWORD ." to " .WORD @ .WORD @ @ + . 2 .WORD +! ;

: STG  PWORD 22 EMIT .WORD @   DUP COUNT TYPE 22 EMIT
   C@ .WORD @ + 1+ .WORD ! ;

' LIT CFA CONSTANT .LIT

: CKIT DUP ZBRAN = OVER BRAN =
 OR OVER PLOOP = OR OVER PPLOOP =
OR IF BRNCH ELSE DUP .LIT =
IF 1WORD ELSE DUP .CLIT =
 IF 1BYTE ELSE DUP PDOTQ = IF STG
 ELSE PWORD THEN THEN THEN THEN ;
-->
