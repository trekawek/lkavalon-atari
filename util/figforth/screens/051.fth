( GRAPHICS COMMANDS )
E456 CONSTANT CIO
  1C VARIABLE MASK
 340 CONSTANT IOCX
  53 VARIABLE SNAME

CODE GR.  1 # LDA,  GFLAG STA,
         XSAVE STX,    0 ,X LDA,
 # 30 LDX,     IOCX 0B + ,X STA,
# 3 LDA,  IOCX 2 + ,X STA,
SNAME FF AND # LDA,  IOCX 4 + ,X
 STA,   SNAME 100 / # LDA,
IOCX 5 + ,X STA,   MASK LDA,
IOCX 0A + ,X STA,    CIO JSR,
XSAVE LDX,   0 # LDY,  POP JMP,
-->
