( DOS OBJECT READER )

: ADRCALC  NEXTWORD DUP ADDRSS ! NEXTWORD SWAP - 1+  #BYTES ! ;

: BLOCKSET  DUP BLOCK# ! BLOCK GETCOUNT ;

: LOADOBJ  BLOCKSET  NEXTWORD 1+ IF CR ." Not an Object file"
 CR QUIT THEN
    BEGIN
         ADRCALC
        #BYTES @ 0 DO NEXTBYTE ADDRSS @ C! 1 ADDRSS +! LOOP
        BLOCK# @ BLOCK FNEXTBLK
   1+ 0= BYTES @ 0= AND   END ;


BASE ! ;S
