( FLOATING POINT WORDS )
 BASE @  HEX
: FDROP   DROP DROP DROP ;
: FDUP    >R >R DUP R> DUP ROT
          SWAP R ROT ROT R> ;
CODE FSWAP
  XSAVE STX, # 6 LDY,
BEGIN,  0 ,X LDA, PHA, INX, DEY,
0= END, XSAVE LDX,  # 6 LDY,
BEGIN, 6 ,X LDA,  0 ,X STA, INX,
DEY, 0= END, XSAVE LDX,  # 6 LDY,
 BEGIN, PLA, 0B ,X STA, DEX, DEY,
0= END,   XSAVE LDX,  NEXT JMP,

XSAVE 100 * 86 + CONSTANT XSAV
: XS,   XSAV ,  ;       -->
