( FLOATING POINT WORDS )
CODE FOVER     DEX, DEX, DEX,
 DEX, DEX, DEX, XSAVE STX,
 # 6 LDY,  BEGIN,  0C ,X LDA,
 0 ,X STA, INX, DEY, 0= END,
 XSAVE LDX,  NEXT JMP,

XSAVE 100 * A6 + CONSTANT XLD
: XL,   XLD  ,  ;

CODE AFP   XS, D800 JSR, XL, NEXT JMP,
CODE FASC  XS, D8E6 JSR, XL, NEXT JMP,
CODE IFP   XS, D9AA JSR, XL, NEXT JMP,    -->



