( DDISK )
BASE @ HEX
0 VARIABLE CBLOCK   0 VARIABLE BUFF
: .HEAD 7D EMIT ." Enter BLOCK number in hex: " QUERY
BL WORD HERE NUMBER DROP CR ;
: GBLK .HEAD CR CR CBLOCK ! ;
: RBLOCK CBLOCK @ BLOCK DUP BUFF ! ;

: .H  0 <# # # #> TYPE SPACE ;
: DLINE  8 0 DO DUP I + C@  .H LOOP ;
: C.ON 1 2FE C! ;  : C.OFF 0 2FE C! ;
: DCHAR C.ON 8 0 DO DUP I + C@ DUP 9B = IF DROP BL THEN
EMIT LOOP C.OFF ;

: FQUIT  DROP 7D EMIT ." ALL DONE" CR DECIMAL  PROMPT QUIT ;
-->
