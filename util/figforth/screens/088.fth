( DDISK )
 HEX  : D.LINE DLINE SPACE DCHAR  ;
: D.BLOCK  3 54 C! 2 55 ! ." BLOCK " CBLOCK @ . CR  RBLOCK
 80 0 DO I .H DUP I + D.LINE DROP CR 8 +LOOP DROP  ;
: PBLK CBLOCK +! D.BLOCK ;
: +BLOCK 1 PBLK ;
: -BLOCK -1 PBLK ;


: PICK SP@ SWAP 2 * + 2+ @ ;
: CKEY KEY DUP 1B = IF FQUIT ELSE DUP 4E = IF +BLOCK ELSE
DUP 42 = IF -BLOCK ELSE DUP 9B = IF GBLK D.BLOCK
 THEN THEN THEN THEN ;
: DDISK  HEX GBLK  D.BLOCK BEGIN CKEY DROP  AGAIN ;

BASE ! ;S
