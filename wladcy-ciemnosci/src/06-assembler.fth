( Target 6502 assembler for the APX fig-Forth cross compiler. )
( Official NMOS 6502 instructions; hex operands follow words. )
( Explicit modes preserve the zero-page/absolute choice. )
( .# immediate; .A accumulator; .ZP/.ZPX/.ZPY zero page. )
( .ABS/.ABSX/.ABSY absolute; .IND/.INDX/.INDY indirect. )
( Branch operands are absolute targets; signed span checked. )
( Output uses B,/W,; host HERE holds only these definitions. )
HEX

( Retain NUMBER's high cell to reject values above FFFF. )
: A-H#
  BL WORD HERE NUMBER
  IF ." ASSEMBLER WORD RANGE" ABORT THEN ;
: A-BYTE
  A-H# DUP FF00 AND
  IF ." ASSEMBLER BYTE RANGE" ABORT THEN B, ;
: A-REL
  A-H# T-LOC @ 1+ -
  DUP 80 + 100 U< 0=
  IF ." ASSEMBLER BRANCH RANGE" ABORT THEN B, ;

( Small DOES> definitions share four instruction emitters. )
: A0: <BUILDS C, T-ROOM DOES> C@ B, ;
: A1: <BUILDS C, T-ROOM DOES> C@ B, A-BYTE ;
: A2: <BUILDS C, T-ROOM DOES> C@ B, A-H# W, ;
: AR: <BUILDS C, T-ROOM DOES> C@ B, A-REL ;

